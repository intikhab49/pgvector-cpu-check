+// The crate is built for baseline x86-64 so the extension loads on any x86-64 CPU. The kernels
+// below get AVX2 and FMA per function instead: the generic simdeez bodies are #[inline(always)],
+// so they are compiled with both features, fmadd included. Callers pick them only when
+// distance::init() found AVX2 and FMA, and use the _sse2 kernels otherwise.
+
+/// L2 distance with AVX2 and FMA.
+#[target_feature(enable = "avx2,fma")]
+pub unsafe fn distance_l2_x86_avx2_fma(x: &[f32], y: &[f32]) -> f32 {
+    distance_l2_x86::<Avx2>(x, y)
+}
+
+/// Inner product with AVX2 and FMA.
+#[target_feature(enable = "avx2,fma")]
+pub unsafe fn inner_product_x86_avx2_fma(x: &[f32], y: &[f32]) -> f32 {
+    inner_product_x86::<Avx2>(x, y)
+}
+
 /// Calculate the cosine distance between two normal vectors
+#[target_feature(enable = "avx2,fma")]
 pub unsafe fn distance_cosine_x86_avx2(x: &[f32], y: &[f32]) -> f32 {
-    (1.0 - inner_product_x86_avx2(x, y)).max(0.0)
+    (1.0 - inner_product_x86::<Avx2>(x, y)).max(0.0)
 }
 
